;; ホストリストが存在しない場合はダイアログから選択
filesearch Host_File
if result = 0 then
  filenamebox 'ホストリストを選択してください' 0
  Host_File = inputstr
  fileopen Host_List Host_File 0
else
  fileopen Host_List Host_File 0
endif

;; 対象となるホストの総数をあらかじめ数えておく。
;; (最後のホストの処理中、まだそのウィンドウとmacroが繋がっている間に
;;  ウィンドウ整列・ブロードキャストダイアログを開きたいので、
;;  何件目が最後かをあらかじめ知っておく必要がある)
Host_Count_Total = 0
filereadln Host_List Host_List_Line
while result = 0
  strlen Host_List_Line
  if result <> 0 then
    strmatch Host_List_Line '^#|^\t'
    if result<>1 then
      Host_Count_Total = Host_Count_Total + 1
    endif
  endif
  filereadln Host_List Host_List_Line
endwhile
fileclose Host_List

;; 数え終わったので、あらためて先頭から読み直す
fileopen Host_List Host_File 0
Processed_Count = 0
Last_Host_Linked = 0

filereadln Host_List Host_List_Line
  while result = 0
    ; ホストリストの最終行に到達したら終了する
    strlen Host_List_Line
    if result = 0 Goto END

    ; ホストリストの先頭が#, TAB以外の場合、対象機器にログインする
    strmatch Host_List_Line '^#|^\t'
    if result<>1 then
      Processed_Count = Processed_Count + 1
      if Processed_Count = Host_Count_Total then
        Is_Last_Host = 1
      else
        Is_Last_Host = 0
      endif
      call CONNECT_PROCESS
    endif

  ; マクロ終了
  :END
    filereadln Host_List Host_List_Line
    endwhile
    fileclose Host_List
    messagebox 'マクロの実行が完了しました' ''

    ;; 最後のホストとの接続がまだmacroとリンクされたままであれば
    ;; (SSH_Login.ttl側でunlinkをスキップしている)、TeraTermの標準機能を
    ;; 使ってウィンドウを整列し、ブロードキャストコマンドのダイアログを開く。
    ;; メニューID(Arrange_Menu_ID / Broadcast_Menu_ID)は sub/設定.ttl で
    ;; 定義しており、既定はSide by Side(50815) / Broadcast command(50445)。
    ;; 対象ウィンドウの選択自体はダイアログ内で手動選択が必要。
    if Last_Host_Linked = 1 then
      callmenu Arrange_Menu_ID
      callmenu Broadcast_Menu_ID
    endif

    end

  ; 対象機器に接続する
  :CONNECT_PROCESS
    ;; TABを区切りとして変数に代入する
    strsplit Host_List_Line '	'
    HOST_DISPLAY = Groupmatchstr1
    HOST_NAME    = Groupmatchstr2
    HOST_IP_1    = Groupmatchstr3
    HOST_OS_1    = Groupmatchstr4
    HOST_USER_1  = Groupmatchstr5
    HOST_IP_2    = Groupmatchstr6
    HOST_OS_2    = Groupmatchstr7
    HOST_USER_2  = Groupmatchstr8

    ;; OSに応じて認証方法を変更する
    strmatch HOST_OS_1 'Linux'
    if result > 0 then
      PROMPT   = Linux_Prompt
      AUTHTYPE = Linux_Authtype
    endif
    strmatch HOST_OS_1 'ESX'
    if result > 0 then
      PROMPT   = ESX_Prompt
      AUTHTYPE = ESX_Authtype
    endif

    ;; ログファイル名を設定する
    gettime Log_Time '%H%M%S'
    sprintf2 Log_File '%s\%s_%s_%s_%s.log' Log_Path HOST_NAME Log_Date Log_Time Log_Str

    sprintf2 Passwd_File_User '%s___%s' HOST_IP_1 HOST_USER_1
    getpassword Passwd_File Passwd_File_User HOST_PASS_1
    if !result then
      messagebox 'Password was not saved' 'ERROR'
    endif

    ;; SSH接続用のコマンドを生成し、接続する。
    sprintf2 COMMAND '%s /ssh /2 /nosecuritywarning /auth=%s /user=%s /passwd=%s' HOST_IP_1 AUTHTYPE HOST_USER_1 HOST_PASS_1
    connect COMMAND

    TIMEOUT = 5
    waitregex PROMPT
    if result = 0 then 
      logclose
      messagebox '接続に失敗しました' 'エラー'
      strconcat Log_File '.error'
      logopen Log_File 0 1 1 1 
      logwrite '*********************************'#13#10
      logwrite 'Hostname:'
      logwrite HOST_NAME
      logwrite #13#10
      logwrite 'UserName:'
      logwrite HOST_USER_1
      logwrite #13#10
      logwrite 'Execution time :'
      sprintf2 str '%s %s ' Log_Date Log_Time
      logwrite str
      logwrite #13#10
      logwrite '*********************************'#13#10
      logclose
      disconnect 
      closett
      return
    endif

    TIMEOUT = Default_Timeout

    include 'sub/SSH_Login.ttl'
    call SSH_Login
