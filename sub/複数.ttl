;; 複数選択ログイン用マクロ
;; ホストリストから複数台を選んで、同じウィンドウで順番にログインする

;; ホストリストが存在しない場合はダイアログから選択
filesearch Host_File
if result = 0 then
  filenamebox 'ホストリストを選択してください' 0
  Host_File = inputstr
  fileopen Host_List Host_File 0
else
  fileopen Host_List Host_File 0
endif

;; ホストリストの行数を取得する。
i = 0
while
  filereadln Host_List Host_List_Line
  if result=1 then
    break
  endif
  i=i+1
endwhile
fileclose Host_List

;; 配列を作成
strdim HOST_LIST_DISPLAY i
strdim HOST_LIST_NAME i
strdim HOST_LIST_IP_1 i
strdim HOST_LIST_IP_2 i
strdim HOST_LIST_OS_1 i
strdim HOST_LIST_OS_2 i
strdim HOST_LIST_USER_1 i
strdim HOST_LIST_USER_2 i
intdim HOST_LIST_SELECTED i

;; ホストリストを読み込む
fileopen Host_List Host_File 0
i = 0
while
  filereadln Host_List Host_List_Line
  if result=1 then
    break
  endif

  ; ホストリストから情報を取得する(空行はスキップする)
  strlen Host_List_Line
  if result <> 0 then
    strmatch Host_List_Line '^#|^\t'
    if result<>1 then
      strsplit Host_List_Line '	'
      HOST_LIST_DISPLAY[i]   = Groupmatchstr1
      HOST_LIST_NAME[i]      = Groupmatchstr2
      HOST_LIST_IP_1[i]      = Groupmatchstr3
      HOST_LIST_OS_1[i]      = Groupmatchstr4
      HOST_LIST_USER_1[i]    = Groupmatchstr5
      HOST_LIST_IP_2[i]      = Groupmatchstr6
      HOST_LIST_OS_2[i]      = Groupmatchstr7
      HOST_LIST_USER_2[i]    = Groupmatchstr8

      i=i+1
    endif
  endif
endwhile
Host_Count = i

if Host_Count = 0 then
  messagebox 'ホストリストにログイン先がありません。' ''
  end
endif

;; チェックマーク付きの表示用配列(末尾に「選択完了」の項目を追加する)
Check_Size = Host_Count
Check_Size = Check_Size + 1
strdim HOST_LIST_CHECK Check_Size
Confirm_Index = Host_Count
HOST_LIST_CHECK[Confirm_Index] = '---- 選択完了(これを選ぶとログイン開始) ----'

;; トグル選択画面
;; 項目を選ぶたびに[x]/[ ]を切り替え、一番下の「選択完了」を選ぶまで繰り返す
Cursor = 0
while 1
  j = 0
  while j < Host_Count
    if HOST_LIST_SELECTED[j] = 1 then
      sprintf2 mark '[x] %s (%s)' HOST_LIST_DISPLAY[j] HOST_LIST_NAME[j]
    else
      sprintf2 mark '[ ] %s (%s)' HOST_LIST_DISPLAY[j] HOST_LIST_NAME[j]
    endif
    HOST_LIST_CHECK[j] = mark
    j = j + 1
  endwhile

  listbox 'クリックでON/OFFを切り替え、選び終えたら一番下の項目を選んでください。' '複数ホスト選択' HOST_LIST_CHECK Cursor 'listboxsize=70x20'

  if result = -1 then
    ;; キャンセル
    end
  endif

  if result = Confirm_Index then
    break
  endif

  Cursor = result
  if HOST_LIST_SELECTED[Cursor] = 1 then
    HOST_LIST_SELECTED[Cursor] = 0
  else
    HOST_LIST_SELECTED[Cursor] = 1
  endif
endwhile

;; 1件も選ばれていなければ終了する
Selected_Count = 0
k = 0
while k < Host_Count
  if HOST_LIST_SELECTED[k] = 1 then
    Selected_Count = Selected_Count + 1
  endif
  k = k + 1
endwhile

if Selected_Count = 0 then
  messagebox 'ホストが選択されていません。' ''
  end
endif

;; 選択したホストへ順番にログインする
k = 0
while k < Host_Count
  if HOST_LIST_SELECTED[k] = 1 then
    call CONNECT_PROCESS
  endif
  k = k + 1
endwhile

messagebox 'マクロの実行が完了しました。' ''
end

;; 対象機器に接続する(k番目のホストへ接続する)
:CONNECT_PROCESS
  HOST_DISPLAY = HOST_LIST_DISPLAY[k]
  HOST_NAME    = HOST_LIST_NAME[k]
  HOST_IP_1    = HOST_LIST_IP_1[k]
  HOST_OS_1    = HOST_LIST_OS_1[k]
  HOST_USER_1  = HOST_LIST_USER_1[k]
  HOST_IP_2    = HOST_LIST_IP_2[k]
  HOST_OS_2    = HOST_LIST_OS_2[k]
  HOST_USER_2  = HOST_LIST_USER_2[k]

  ;; OSに応じて認証方法を変更する
  strmatch HOST_OS_1 'Linux'
  if result > 0 then
    PROMPT   = Linux_Prompt
    AUTHTYPE = Linux_Authtype
  endif
  strmatch HOST_OS_1 'ESX'
  if result > 0 then
    PROMPT   = ESX_Prompt
    AUTHTYPE = ESX_Authtype
  endif

  ;; ログファイル名を設定する
  gettime Log_Time '%H%M%S'
  sprintf2 Log_File '%s\%s_%s_%s_%s.log' Log_Path HOST_NAME Log_Date Log_Time Log_Str

  sprintf2 Passwd_File_User '%s___%s' HOST_IP_1 HOST_USER_1
  getpassword Passwd_File Passwd_File_User HOST_PASS_1
  if !result then
    messagebox 'Password was not saved' 'ERROR'
  endif

  ;; SSH接続用のコマンドを生成し、接続する。
  sprintf2 COMMAND '%s /ssh /2 /nosecuritywarning /auth=%s /user=%s /passwd=%s' HOST_IP_1 AUTHTYPE HOST_USER_1 HOST_PASS_1
  connect COMMAND

  TIMEOUT = 5
  waitregex PROMPT
  if result = 0 then
    logclose
    messagebox '接続に失敗しました' 'エラー'
    strconcat Log_File '.error'
    logopen Log_File 0 1 1 1
    logwrite '*********************************'#13#10
    logwrite 'Hostname:'
    logwrite HOST_NAME
    logwrite #13#10
    logwrite 'UserName:'
    logwrite HOST_USER_1
    logwrite #13#10
    logwrite 'Execution time :'
    sprintf2 str '%s %s ' Log_Date Log_Time
    logwrite str
    logwrite #13#10
    logwrite '*********************************'#13#10
    logclose
    disconnect
    closett
    return
  endif

  TIMEOUT = Default_Timeout

  include 'sub/SSH_Login.ttl'
  call SSH_Login
  return
